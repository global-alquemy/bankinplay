<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="bankinplay_view_company_form">
        <field name="name">bankinplay.view.company.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="bankinplay" string="BankInPlay">
                    <group name="bankinplay-columns">
                        <group name="bankinplay-col1">
                            <group name="bankinplay" string="BankInPlay Config">
                                <field name="bankinplay_apikey"/>
                                <field name="bankinplay_apisecret"/>
                                <field name="bankinplay_company_id" readonly="1"/>
                                <button name="test_bankinplay_connection" colspan="2" type="object" string="Test Connection" icon="fa-television" class="btn-primary w-100 mb-2"/>
                            </group>
                            <group name="bankinplay_config">
                                <separator string="Callbacks" colspan="2"/>
                                <button name="bankinplay_register_callbacks" type="object" string="Registrar Callbacks" icon="fa-link" class="btn-warning w-100 mb-1" colspan="2"/>
                                <button name="bankinplay_check_callbacks" type="object" string="Comprobar Callbacks" icon="fa-check-circle" class="btn-info w-100 mb-1" colspan="2"/>
                                <separator string="Configuración masiva" colspan="2"/>
                                <button name="%(account_statement_import_online_bankinplay.action_bankinplay_mass_config_wizard)d" type="action" string="Configuración masiva extractos" icon="fa-cogs" class="btn-secondary w-100 mb-1" colspan="2"/>
                            </group>
                        </group>
                        <group name="bankinplay-col2">
                        </group>
                    </group>
                    
                </page>
            </notebook>

        </field>
    </record>

</odoo>
