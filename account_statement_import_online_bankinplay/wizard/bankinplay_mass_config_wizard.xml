<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bankinplay_mass_config_wizard_form" model="ir.ui.view">
        <field name="name">bankinplay.mass.config.wizard.form</field>
        <field name="model">bankinplay.mass.config.wizard</field>
        <field name="arch" type="xml">
            <form string="Configure Bankinplay for Multiple Journals">
                <group>
                    <group string="Company">
                        <field name="company_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group string="Journals">
                        <field name="journal_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="Select bank journals..."/>
                        <button name="action_select_all_journals"
                                string="Select All Bank Journals"
                                type="object"
                                class="btn-link"
                                icon="fa-check-square-o"/>
                    </group>
                </group>
                <group>
                    <group string="Bankinplay Settings">
                        <field name="bankinplay_import_type"/>
                        <field name="bankinplay_date_field"/>
                        <field name="tz"/>
                    </group>
                    <group string="Schedule Settings">
                        <label for="interval_number" string="Update Every"/>
                        <div class="o_row">
                            <field name="interval_number" class="oe_inline"/>
                            <field name="interval_type" class="oe_inline"/>
                        </div>
                        <field name="statement_creation_mode"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="overwrite_existing"/>
                    </group>
                </group>
                <footer>
                    <button name="action_configure" string="Configure Selected Journals" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bankinplay_mass_config_wizard" model="ir.actions.act_window">
        <field name="name">Configure Bankinplay</field>
        <field name="res_model">bankinplay.mass.config.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_bankinplay_mass_config"
              name="Mass Configure Bankinplay"
              action="action_bankinplay_mass_config_wizard"
              parent="account.menu_finance_configuration"
              sequence="100"/>
</odoo>
