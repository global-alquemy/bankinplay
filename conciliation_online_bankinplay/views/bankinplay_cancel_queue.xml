<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Vista Tree -->
    <record id="bankinplay_cancel_queue_tree" model="ir.ui.view">
        <field name="name">bankinplay.cancel.queue.tree</field>
        <field name="model">bankinplay.cancel.queue</field>
        <field name="arch" type="xml">
            <tree string="Cola de anulaciones BankinPlay">
                <field name="create_date" string="Fecha"/>
                <field name="company_id"/>
                <field name="move_line_id"/>
                <field name="move_name"/>
                <field name="partner_name"/>
                <field name="state" decoration-success="state == 'done'" decoration-danger="state == 'error'" decoration-warning="state == 'pending'" widget="badge"/>
                <field name="process_date"/>
                <field name="error_message" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="bankinplay_cancel_queue_form" model="ir.ui.view">
        <field name="name">bankinplay.cancel.queue.form</field>
        <field name="model">bankinplay.cancel.queue</field>
        <field name="arch" type="xml">
            <form string="Anulación BankinPlay">
                <header>
                    <button name="process_cancel_queue" type="object" string="Procesar" class="btn-primary" states="pending,error"/>
                    <button name="retry_failed" type="object" string="Reintentar" class="btn-secondary" states="error"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" readonly="1"/>
                            <field name="move_line_id" readonly="1"/>
                            <field name="move_name" readonly="1"/>
                            <field name="partner_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="process_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Error" attrs="{'invisible': [('state', '!=', 'error')]}">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="bankinplay_cancel_queue_action" model="ir.actions.act_window">
        <field name="name">Cola de anulaciones</field>
        <field name="res_model">bankinplay.cancel.queue</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <!-- Menú: Cola de anulaciones bajo Contabilidad > Bancos -->
    <menuitem
        id="menu_bankinplay_cancel_queue"
        name="BankInPlay: Cola de anulaciones"
        parent="account.account_banks_menu"
        action="bankinplay_cancel_queue_action"
        sequence="25"
        groups="account.group_account_manager"/>

    <!-- Search View -->
    <record id="bankinplay_cancel_queue_search" model="ir.ui.view">
        <field name="name">bankinplay.cancel.queue.search</field>
        <field name="model">bankinplay.cancel.queue</field>
        <field name="arch" type="xml">
            <search string="Cola de anulaciones">
                <field name="move_name"/>
                <field name="partner_name"/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'pending')]"/>
                <filter name="done" string="Procesados" domain="[('state', '=', 'done')]"/>
                <filter name="error" string="Con error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Empresa" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
