<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Heredar vista tree de account.move.line -->
    <record id="view_move_line_tree_bankinplay" model="ir.ui.view">
        <field name="name">account.move.line.tree.bankinplay</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='balance']" position="after">
                <field name="bankinplay_sent" optional="hide"/>
                <field name="bankinplay_needs_update" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Heredar vista form de account.move.line -->
    <record id="view_move_line_form_bankinplay" model="ir.ui.view">
        <field name="name">account.move.line.form.bankinplay</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="BankInPlay" name="bankinplay_group">
                    <group>
                        <field name="bankinplay_sent" readonly="1"/>
                        <field name="bankinplay_needs_update" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
