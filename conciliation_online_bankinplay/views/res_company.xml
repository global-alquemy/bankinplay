<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="bankinplay_conciliation_view_company_form">
        <field name="name">bankinplay.conciliation.view.company.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="account_statement_import_online_bankinplay.bankinplay_view_company_form" />
        <field name="arch" type="xml">
            <field name="bankinplay_company_id" position="after">
                <field name="bankinplay_enabled"/>
                <field name="bankinplay_start_date"/>
                <field name="bankinplay_bank_statement_start_date"/>
                <field name="bankinplay_bank_statements_synced"/>
                <field name="bankinplay_partner_domain" widget="domain" options="{'model': 'res.partner', 'in_dialog': True}"/>
                <field name="bankinplay_journal_ids" widget="many2many_tags"/>
            </field>
            <group name="bankinplay_config" position="inside">
                    <separator string="Configuración masiva" colspan="2"/>
                    <button name="%(account_statement_import_online_bankinplay.action_bankinplay_mass_config_wizard)d" type="action" string="Configuración masiva extractos" icon="fa-cogs" class="btn-secondary w-100 mb-1" colspan="2"/>
                    <button name="%(action_bankinplay_mass_company_wizard_server)d" type="action" string="Configuración masiva compañías" icon="fa-building" class="btn-secondary w-100 mb-1" colspan="2"/>

            </group>
            <group name="bankinplay-col2" position="inside">
                <group string="Plan contable">
                    <field name="bankinplay_analytic_plan_id" readonly="0"/>
                    <field name="bankinplay_analytic_line_id" readonly="0"/>
                    <button name="export_account_plan" type="object" string="Exportar plan contable" class="btn-primary w-100 mb-1" colspan="2"/>
                    <button name="export_analytic_plan" type="object" string="Exportar plan analítico" class="btn-primary w-100 mb-1" colspan="2"/>
                </group>
                <group string="Terceros">
                    <field name="bankinplay_manage_third_accounts"/>
                    <field name="bankinplay_last_syncdate"/>
                    <button name="bankinplay_export_documents" type="object" string="Exportar documentos" class="btn-primary w-100 mb-1" colspan="2"/>
                    <button name="bankinplay_import_documents" type="object" string="Importar documentos" class="btn-primary w-100 mb-1" colspan="2"/>
                </group>
                <group string="Apuntes contables">
                    <button name="bankinplay_import_account_moves" type="object" string="Importar movimientos contables" class="btn-primary w-100 mb-1" colspan="2"/>
                    <button name="bankinplay_export_account_move_line" type="object" string="Exportar apuntes contables" class="btn-primary w-100 mb-1" colspan="2"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
